        case 1:
            cues = kPhoneSubtitleNight1;
            count = sizeof(kPhoneSubtitleNight1) / sizeof(kPhoneSubtitleNight1[0]);
            break;
        case 2:
            cues = kPhoneSubtitleNight2;
            count = sizeof(kPhoneSubtitleNight2) / sizeof(kPhoneSubtitleNight2[0]);
            break;
        case 3:
            cues = kPhoneSubtitleNight3;
            count = sizeof(kPhoneSubtitleNight3) / sizeof(kPhoneSubtitleNight3[0]);
            break;
        case 4:
            cues = kPhoneSubtitleNight4;
            count = sizeof(kPhoneSubtitleNight4) / sizeof(kPhoneSubtitleNight4[0]);
            break;
        case 5:
            cues = kPhoneSubtitleNight5;
            count = sizeof(kPhoneSubtitleNight5) / sizeof(kPhoneSubtitleNight5[0]);
            break;
        default:
            return NULL;
    }

    if (duration == 0u || count == 0u) return NULL;
    uint32_t position = (frames * 1000u) / duration;
    if (position > 1000u) position = 1000u;

    for (size_t i = 0u; i < count; ++i) {
        if (position < cues[i].end_permille || i + 1u == count)
            return &cues[i];
    }
    return NULL;
}

static const char *phone_subtitle_speaker_name(const PhoneSubtitleCue *cue)
{
    if (cue == NULL) return "PHONE";
    return cue->speaker == PHONE_SUBTITLE_DUDE ? "PHONE DUDE" : "PHONE GUY";
}

static void phone_subtitles_draw(void)
{
    if (!sFinishing.phone_active || !wiiu_controls_subtitles_enabled()) return;

    const PhoneSubtitleCue *cue =
        phone_subtitle_current(sFinishing.phone_night,
                               sFinishing.phone_frames,
                               sFinishing.phone_duration);
    if (cue == NULL) return;

    const bool french = wiiu_controls_language() == WIIU_LANGUAGE_FRENCH;
    const char *text = french ? cue->french : cue->english;
    const char *speaker = phone_subtitle_speaker_name(cue);
    const uint32_t target = GRAPHICS_TARGET_BOTH;
    const uint32_t border = GRAPHICS_RGB(122, 164, 108);
    const uint32_t panel = GRAPHICS_RGB(1, 5, 2);

    /* Night 2 starts with Phone Dude and then switches to the archival
     * Phone Guy training tape. Correct the small legacy call label too. */
    if (sFinishing.phone_night == 2 && cue->speaker == PHONE_SUBTITLE_GUY) {
        graphics_draw_rect(target, 566, 66, 168, 24, GRAPHICS_RGB(2, 8, 4));
        graphics_draw_text(target, 570, 70, 2, "PHONE GUY", border);
    }

    graphics_draw_rect(target, 54, 368, 746, 102, panel);
    graphics_draw_frame(target, 54, 368, 746, 102, 2, border);
    graphics_draw_text(target, 72, 378, 1, speaker, border);
    graphics_draw_text(target, 72, 398, 2, text, COLOUR_WHITE);
}

static void finishing_draw_phone_overlay(void)
{
    finishing_draw_phone_overlay_base();
    phone_subtitles_draw();
}
